# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Agents backend API URL (optional, for production)
# Leave unset for local dev (defaults to http://localhost:8000)
# Set to your Railway backend URL when deploying frontend to Vercel
# VITE_API_URL=https://your-app.up.railway.app
